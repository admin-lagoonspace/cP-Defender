# Force LF line endings for all shell/server files
* text=auto
*.sh text eol=lf
*.php text eol=lf
*.py text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.conf text eol=lf
*.service text eol=lf
*.sig text eol=lf

# The site's .htaccess block is merged by a shell script that matches marker
# lines exactly; a CRLF checkout must not change what it reads.
website/htaccess.site text eol=lf
